# ===== إعدادات بوت نوفا (انسخ الملف إلى .env ثم عبّي القيم) =====
# لا ترفع ملف .env إلى GitHub أبداً.

# --- إلزامي: تشغيل البوت ---
# توكن البوت من Discord Developer Portal > Bot > Reset Token
DISCORD_TOKEN=

# --- لوحة التحكم /dashboard (OAuth2) ---
# من Developer Portal > OAuth2 > General
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# مفتاح عشوائي طويل لتوقيع الجلسات (أي نص سري طويل)
SESSION_SECRET=

# --- رابط النشر العام (يُستخدم في OAuth Redirect URI) ---
# Render يحطّه تلقائياً في RENDER_EXTERNAL_URL، أو حطّه يدوياً
PUBLIC_URL=
RENDER_EXTERNAL_URL=

# --- التخزين الدائم (مستحسن بشدة) ---
# بدون MONGODB_URI: كل التعديلات تضيع عند إعادة التشغيل
MONGODB_URI=
MONGODB_DB=divelbot

# --- لوحة تحرير الردود /panel ---
ADMIN_PASSWORD=

# --- اختياري ---
# فعّل Server Members Intent في موقع المطورين ثم حط القيمة 1 (للبحث بالاسم والترحيب)
MEMBERS_INTENT=1
# نبض البقاء (يمنع نوم الخدمة على Render المجاني): 1 مفعّل، 0 مطفي
# تنبيه: 1 يستهلك ~744 ساعة من أصل 750 ساعة مجانية بالشهر → لو الخدمة انسحبت (Suspended) حط 0
KEEPALIVE=1
# نفق Cloudflare التلقائي: 1 يفتح رابط HTTPS عام للوحة (للاستضافات اللي ما تعطي رابط مثل HeavenCloud/Wispbyte)
# على Render اتركه فاضي/0 (Render يعطي رابط HTTPS أصلاً)
TUNNEL=0
# منفذ سيرفر الويب (Render يحدده تلقائياً)
PORT=3000
# مجلد حفظ البيانات المؤقتة
DATA_DIR=
